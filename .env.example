# ===================================================
# GateNest - Environment Configuration Example
# ===================================================

# Application Profile ('prod', 'dev', or 'demo')
SPRING_PROFILES_ACTIVE=prod

# Production Docker Compose Settings
PORT=80
APP_PUBLIC_URL=http://localhost
DB_NAME=gatenest_db
DB_USER=gatenest_user
DB_PASSWORD=gatenest_password
DB_ROOT_PASSWORD=root_gatenest_secure_2026

# Standalone Spring Boot Database Connectivity (MySQL 8.4 LTS)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/gatenest_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=gatenest_user
SPRING_DATASOURCE_PASSWORD=gatenest_password

# Administrator Bootstrap Token (Required to bootstrap initial admin via API/scripts)
GATENEST_BOOTSTRAP_TOKEN=bootstrap-gatenest-admin-secret-2026

# Estate Timezone (Default: Asia/Kolkata)
GATENEST_TIMEZONE=Asia/Kolkata

# Allowed CORS Origins (Comma-separated)
GATENEST_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
COOKIE_SECURE=false

